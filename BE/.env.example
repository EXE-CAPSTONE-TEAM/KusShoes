# App
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
SERVICE_TOKEN=your-service-token-for-editor-app

# Database (primary) — Neon Direct connection, SQLAlchemy asyncpg format.
# Change Neon's scheme to postgresql+asyncpg:// and use ssl=require.
DATABASE_URL=postgresql+asyncpg://YOUR_ROLE:YOUR_PASSWORD@YOUR_ENDPOINT.neon.tech/YOUR_DATABASE?ssl=require

# Redis
REDIS_URL=redis://redis:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=30
SSO_TOKEN_EXPIRE_MINUTES=5
REFRESH_COOKIE_NAME=kusshoes_refresh_token
REFRESH_COOKIE_SAMESITE=lax

# Authentication abuse protection
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT=30
REFRESH_RATE_WINDOW_SECONDS=60
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600

# Editor / desktop launch (KusStudio mở qua deep link kusshoes-editor://)
EDITOR_LAUNCH_TICKET_EXPIRE_SECONDS=60
EDITOR_AUTH_CODE_EXPIRE_SECONDS=60
EDITOR_ACCESS_TOKEN_EXPIRE_MINUTES=15
EDITOR_DESKTOP_URL_SCHEME=kusshoes-editor

# Bake worker = ar-ai-exe/backend (repo ar-ai-exe, service `backend`, cổng 8010).
# EDITOR_WORKER_SERVICE_TOKEN phải trùng CONTROL_PLANE_SERVICE_TOKEN bên ar-ai-exe.
# Để trống EDITOR_WORKER_URL nếu chưa chạy worker — bake sẽ báo lỗi cấu hình.
# Chạy trong Docker → dùng host.docker.internal (compose đã map host-gateway).
# Chạy API ngoài Docker thì đổi thành http://localhost:8010
EDITOR_WORKER_URL=http://host.docker.internal:8010
EDITOR_WORKER_SERVICE_TOKEN=
EDITOR_WORKER_TIMEOUT_SECONDS=300

# Mobile compute (PHASE SAU — luồng scan mobile, hiện chưa dùng).
# Model 3D tạm thời import thủ công từ KusStudio desktop.
MOBILE_COMPUTE_URL=
MOBILE_COMPUTE_SERVICE_TOKEN=
MOBILE_GRANT_TTL_SECONDS=60
MOBILE_COMPLETION_TTL_SECONDS=259200
MOBILE_OUTPUT_UPLOAD_TTL_SECONDS=900

# Storage (MinIO local — dùng tên service trong Docker)
# Production dùng Cloudflare R2: xem .env.production.example
# Khi bake worker (ar-ai-exe) chạy ngoài compose này, presigned URL phải trỏ tới
# host mà cả hai bên đều resolve được → dùng host.docker.internal:9000.
# Chỉ chạy KusShoes một mình thì http://minio:9000 là đủ.
STORAGE_ENDPOINT=http://host.docker.internal:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=kusshoes
STORAGE_PUBLIC_URL=http://localhost:9000/kusshoes
STORAGE_REGION=us-east-1

# KIRI Engine (3D scan — để trống khi dev, cần khi port scan pipeline Phase 2)
KIRI_API_TOKEN=
KIRI_API_BASE_URL=https://api.kiriengine.app/api

# Email (SMTP — dùng cho OTP verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=noreply@kusshoes.vn

# Sentry (để trống khi dev)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# PayOS (billing) — https://payos.vn — lấy từ Kênh thanh toán → Cấu hình
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:5173/billing/success
PAYOS_CANCEL_URL=http://localhost:5173/billing/cancel

# MoMo (billing) — https://developers.momo.vn — test endpoint dùng cho sandbox
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/billing/success
MOMO_IPN_URL=http://localhost:8000/api/v1/webhooks/momo
